# PostgreSQL is the relational source of truth.
DATABASE_URL=postgresql+psycopg://cims:cims_password@127.0.0.1:5432/cims

# MongoDB stores high-volume security log documents only.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=cims_logs

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# This placeholder is intentionally rejected at startup and is not a usable secret.
JWT_SECRET_KEY=GENERATE_WITH_THE_COMMAND_ABOVE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8501
